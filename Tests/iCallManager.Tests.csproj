<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Fixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\Bridge\*.cs" Link="Bridge\%(Filename)%(Extension)" />
    <Compile Include="..\ICall\RowParser.cs" Link="ICall\RowParser.cs" />
    <Compile Include="..\ICall\DummyAssignmentParser.cs" Link="ICall\DummyAssignmentParser.cs" />
  </ItemGroup>
</Project>
